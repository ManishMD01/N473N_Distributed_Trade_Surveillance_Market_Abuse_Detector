# =====================================================
# Environment Variables - Trade Surveillance System
# Copy this to .env and fill in your values
# =====================================================

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=market-orders

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=surveillance123

# TimescaleDB/PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=surveillance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Google BigQuery
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json
BIGQUERY_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET=surveillance
BIGQUERY_TABLE_ALERTS=market_abuse_alerts
GCS_TEMP_BUCKET=your-temporary-gcs-bucket

# Spark
SPARK_MASTER=local[*]
SPARK_CHECKPOINT_LOCATION=/tmp/surveillance-checkpoint

# API
API_HOST=0.0.0.0
API_PORT=8000

# GUI
FLASK_PORT=5000
PHP_PORT=8080
